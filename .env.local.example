# ──────────────────────────────────────────────────────────────────
# LPIC×CCNA 学習室 — 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください。
# .env.local は .gitignore に含まれており GitHub には push されません。
# ──────────────────────────────────────────────────────────────────

# ── AWS 基本設定 ──────────────────────────────────────────────────
AWS_REGION=ap-northeast-1

# ── 開発環境用 IAM 認証情報（本番は App Runner の IAM ロールを使用）─
# 本番環境ではこの値は不要（App Runner に IAM ロールを割り当てます）
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# ── DynamoDB テーブル名 ───────────────────────────────────────────
DYNAMODB_TABLE_NAME=Questions
DYNAMODB_USER_PROGRESS_TABLE=UserProgress
DYNAMODB_USER_ANSWERS_TABLE=UserAnswers

# ── Cognito 認証設定 ──────────────────────────────────────────────
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Lambda (submitAnswer) 関数 URL ────────────────────────────────
NEXT_PUBLIC_SUBMIT_ANSWER_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-northeast-1.on.aws/

# ── S3 教材バケット（オプション：assets 公開後に設定） ─────────────
# NEXT_PUBLIC_ASSETS_BUCKET_URL=https://xxxxxxxxxx.cloudfront.net
