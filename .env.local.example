# ──────────────────────────────────────────────────────────
# AWS 認証情報（このファイルは .gitignore に含めること）
# ──────────────────────────────────────────────────────────

# AWS リージョン（例: ap-northeast-1 = 東京）
AWS_REGION=ap-northeast-1

# IAM アクセスキー（DynamoDB 読み取り権限が必要）
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# DynamoDB テーブル名
DYNAMODB_TABLE_NAME=Questions

# Cognito 認証設定
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Lambda (submitAnswer) 関数 URL
NEXT_PUBLIC_SUBMIT_ANSWER_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-northeast-1.on.aws/
