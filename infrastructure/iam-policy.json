{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-1:*:table/Questions",
        "arn:aws:dynamodb:ap-northeast-1:*:table/Questions/*",
        "arn:aws:dynamodb:ap-northeast-1:*:table/UserProgress",
        "arn:aws:dynamodb:ap-northeast-1:*:table/UserProgress/*",
        "arn:aws:dynamodb:ap-northeast-1:*:table/UserAnswers",
        "arn:aws:dynamodb:ap-northeast-1:*:table/UserAnswers/*"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:*:log-group:/aws/apprunner/lpic-ccna-app:*"
    },
    {
      "Sid": "S3AssetsRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::lpic-ccna-assets/*"
    },
    {
      "Sid": "LambdaInvoke",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:*:function:lpic-ccna-*"
    }
  ]
}
